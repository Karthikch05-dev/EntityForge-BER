{
  "version": 2,
  "builds": [
    {
      "src": "entity_resolver_app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "includeFiles": ["run_solution.py", "templates/**", "dataset/train/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "entity_resolver_app.py"
    }
  ]
}
